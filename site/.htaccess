# AKH IT Solutions: Apache rules for akhitsolutions.com (Round 28, SEO migration).
# Keeps every old URL working: most old paths map straight onto a page of the same name,
# the rest get a permanent (301) redirect. Full map and test list: docs/seo-migration.md.
# Needs mod_rewrite (and mod_headers, mod_deflate, mod_expires for the performance rules).

Options -MultiViews -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# 1. One host: HTTPS, no www.
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://akhitsolutions.com%{REQUEST_URI} [R=301,L,NE]

# 2. Old pages with no page of their own on the new site.
RewriteRule ^blog/?$ /news-events [R=301,L]
RewriteRule ^portfolio/?$ /#selected-work [R=301,L,NE]
RewriteRule ^(about|about-akh)/?$ /about-us [R=301,L]
RewriteRule ^contact/?$ /contact-us [R=301,L]
RewriteRule ^service/?$ /services [R=301,L]
RewriteRule ^terms(-and-conditions)?/?$ /terms-and-condition [R=301,L]
RewriteRule ^privacy/?$ /privacy-policy [R=301,L]
RewriteRule ^(news|events)/?$ /news-events [R=301,L]
# The Work page stays off the live site until it is ready.
RewriteRule ^portfolio\.html$ /#selected-work [R=301,L,NE]

# 3. Clean URLs: /about-us.html -> /about-us, /index.html -> / (only for browser requests, not internal rewrites).
RewriteCond %{THE_REQUEST} \s/+(.*?/)?index\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]
RewriteCond %{THE_REQUEST} \s/+([^?\s]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# 4. Trailing slashes on pages: /about-us/ -> /about-us.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# 5. Serve /about-us from about-us.html.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

# ---- Performance ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/plain application/xml
</IfModule>
<IfModule mod_mime.c>
  AddType image/webp .webp
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType image/x-icon "access plus 6 months"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
  # CSS and JS links carry ?v= tags, so they can be cached for a long time.
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
